{
  "manifest_version": 3,
  "name": "NUKE Underdog Exposure",
  "version": "0.1.0",
  "description": "Track NFL Daily Draft player and combo exposure on Underdog.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://underdogfantasy.com/*", "https://*.underdogfantasy.com/*"],
  "action": {
    "default_title": "NUKE Exposure",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["https://underdogfantasy.com/*", "https://*.underdogfantasy.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}