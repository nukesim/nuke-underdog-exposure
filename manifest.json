{
  "manifest_version": 3,
  "name": "NUKE Underdog Exposure",
  "version": "0.8.2",
  "description": "Fast live Underdog exposure by sport, tournament, or overall.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://underdogfantasy.com/*",
    "https://*.underdogfantasy.com/*",
    "https://app.underdogsports.com/*",
    "https://*.underdogsports.com/*"
  ],
  "action": {
    "default_title": "NUKE Exposure",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://underdogfantasy.com/*",
        "https://*.underdogfantasy.com/*",
        "https://app.underdogsports.com/*",
        "https://*.underdogsports.com/*"
      ],
      "js": [
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://underdogfantasy.com/*",
        "https://*.underdogfantasy.com/*",
        "https://app.underdogsports.com/*",
        "https://*.underdogsports.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
